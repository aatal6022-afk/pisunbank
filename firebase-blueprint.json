{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in MURBANK",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "googleId": { "type": "string" },
        "name": { "type": "string" },
        "gameNickname": { "type": "string" },
        "avatar": { "type": "string" },
        "password": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "isEmployee": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "gameNickname", "createdAt"]
    },
    "BankCard": {
      "title": "BankCard",
      "description": "Bank card issued by MURBANK",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "cardNumber": { "type": "string" },
        "cardHolderName": { "type": "string" },
        "cardType": { "type": "string" },
        "color": { "type": "string" },
        "balance": { "type": "number" },
        "issueDate": { "type": "string" },
        "cvv": { "type": "string" },
        "status": { "type": "string" },
        "isFrozen": { "type": "boolean" },
        "freezeDays": { "type": "number" },
        "frozenAt": { "type": "string" },
        "frozenUntil": { "type": "string" },
        "lastActivityDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "cardNumber", "cardHolderName", "cardType", "color", "balance", "cvv", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction in MURBANK",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cardId": { "type": "string" },
        "cardNumber": { "type": "string" },
        "fromCardNumber": { "type": "string" },
        "toCardNumber": { "type": "string" },
        "senderName": { "type": "string" },
        "recipientName": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "amount", "type", "createdAt"]
    },
    "CreditLoan": {
      "title": "CreditLoan",
      "description": "Credit loan issued by MURBANK",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cardId": { "type": "string" },
        "principal": { "type": "number" },
        "interestRate": { "type": "number" },
        "totalRepayAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "termMonths": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "cardId", "principal", "remainingAmount", "status", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Merchant invoice in MURBANK acquiring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "merchantName": { "type": "string" },
        "merchantUserId": { "type": "string" },
        "recipientCardNumber": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "payerCardNumber": { "type": "string" },
        "paidAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientCardNumber", "amount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered citizens and bank personnel"
    },
    "/cards/{cardId}": {
      "schema": "BankCard",
      "description": "MURBANK issued bank cards"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "History of money transfers, taxes, emissions, and merchant payments"
    },
    "/credits/{creditId}": {
      "schema": "CreditLoan",
      "description": "Active and completed 5% credit loans"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Merchant acquiring bills and payment orders"
    }
  }
}
